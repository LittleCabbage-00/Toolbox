<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 8–9 下载到公共 Download 目录时才需要；Android 10+ 不会请求。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Android 11+ 的包可见性限制下，仅声明需要定向打开的系统文件管理器。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.android.fileexplorer" />
        <package android:name="com.huawei.hidisk" />
        <package android:name="com.huawei.filemanager" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.oplus.filemanager" />
        <package android:name="com.android.filemanager" />
        <package android:name="com.vivo.filemanager" />
        <package android:name="com.lenovo.FileBrowser" />
        <package android:name="com.sec.android.app.myfiles" />
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/MDTheme">

        <service
            android:name=".Browser.BrowserDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".Activities.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.DataToolsActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.UnitConverterActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.MediaTranscodeActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.ApiDebugActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.NetworkUtilitiesActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.EnterSearchStringFragment"
            android:exported="false"
            android:theme="@style/Theme.Toolbox.EnterSearch"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Activities.SearchActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".Activities.BrowserHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.BrowserFavoritesActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.BrowserDownloadsActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.BingWallpaperGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.BingWallpaperDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.google.zxing.activity.CaptureActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.FakeTerminalActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.UsingHelperActivity"
            android:exported="false" />
        <activity
            android:name=".Activities.AboutActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".Activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Toolbox.Main"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activities.PicActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".Activities.TextActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".Activities.FileActivity"
            android:exported="false"
            android:launchMode="singleTask" />
    </application>

</manifest>
