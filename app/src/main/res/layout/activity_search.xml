<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/browserToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="?attr/colorSurface"
        android:elevation="3dp"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/browserExit"
                style="@style/Widget.Toolbox.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="返回工具箱"
                android:text=""
                app:icon="@drawable/ic_close_24" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/browser_surface_variant"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/browser_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp">

                    <ImageView
                        android:id="@+id/webIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="网站图标"
                        android:padding="9dp"
                        android:src="@drawable/web_internet"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <EditText
                        android:id="@+id/textUrl"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="搜索或输入网址"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:selectAllOnFocus="true"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStart"
                        style="@style/Widget.Toolbox.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="前往或刷新"
                        android:text=""
                        app:icon="@drawable/ic_refresh_24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 类似桌面 Chrome 书签栏：由设置开关控制，横向滚动避免挤压地址栏。 -->
    <HorizontalScrollView
        android:id="@+id/bookmarkBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="?attr/colorSurface"
        android:fillViewport="false"
        android:overScrollMode="always"
        android:scrollbars="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/bookmarkItems"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100" />
    </FrameLayout>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/browserBottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foregroundGravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/goBack"
                    style="@style/Widget.Toolbox.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="后退"
                    android:text=""
                    app:icon="@drawable/ic_arrow_back_24"
                    app:iconSize="20dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foregroundGravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/goForward"
                    style="@style/Widget.Toolbox.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="前进"
                    android:text=""
                    app:icon="@drawable/ic_arrow_forward_24"
                    app:iconSize="20dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foregroundGravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/goHome"
                    style="@style/Widget.Toolbox.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="浏览器主页"
                    android:text=""
                    app:icon="@drawable/ic_home_24"
                    app:iconSize="20dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foregroundGravity="center">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/navTabs"
                        style="@style/Widget.Toolbox.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="标签页"
                        android:text=""
                        app:icon="@drawable/ic_tabs_24"
                        app:iconSize="20dp" />

                    <TextView
                        android:id="@+id/tabCount"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-1dp"
                        android:layout_marginEnd="-1dp"
                        android:background="@drawable/browser_tab_badge"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="1"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foregroundGravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/navSet"
                    style="@style/Widget.Toolbox.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="更多浏览器功能"
                    android:text=""
                    app:icon="@drawable/ic_more_vert_24"
                    app:iconSize="20dp" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
</LinearLayout>
