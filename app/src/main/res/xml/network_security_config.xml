<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 内置浏览器需要允许用户主动访问旧式 HTTP 站点；应用自身接口仍全部使用 HTTPS。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
